APP_NAME="HaloKIP Penilai Eksternal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://halokip.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesi & cache memakai file agar tidak butuh tabel tambahan di shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---------------------------------------------------------------
# Sinkronisasi dengan sistem pusat (emonev-refactor)
# ---------------------------------------------------------------
# Rahasia bersama untuk tanda tangan HMAC. Buat dengan: php -r "echo bin2hex(random_bytes(32));"
# Nilai yang sama harus dipasang di .env sistem pusat (SATELLITE_SECRET).
SYNC_SECRET=
# Saat rotasi kunci: isi rahasia lama di sini, ganti SYNC_SECRET dengan yang baru,
# lalu hapus nilai lama setelah pusat memakai rahasia baru.
SYNC_SECRET_PREVIOUS=
# Opsional: daftar IP yang boleh memanggil API sinkronisasi, dipisah koma. Kosong = tidak dibatasi.
SYNC_ALLOWED_IPS=
# Toleransi selisih jam (detik) antara pusat dan satelit.
SYNC_MAX_SKEW=300

# ---------------------------------------------------------------
# Keamanan login penilai
# ---------------------------------------------------------------
# Verifikasi kode 6 digit lewat email setelah kata sandi benar. WAJIB true di produksi,
# dan MAIL_* di bawah harus sudah berfungsi (kalau tidak, penilai tidak bisa login).
EXTERNAL_LOGIN_OTP=true
EXTERNAL_OTP_TTL_MINUTES=10

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@halokip.my.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
